<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows10.0.19041.0;net8.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>GoChat</RootNamespace>
    <UseMaui>true</UseMaui>
    <ApplicationTitle>GoChat 2.1 - ChatGPT Go</ApplicationTitle>
    <ApplicationId>com.alvaromente.gptgo</ApplicationId>
  </PropertyGroup>
  <ItemGroup>
    <MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
